# Copia este archivo como ".env" antes de iniciar el servidor.
# Nunca subas tu archivo ".env" real a un repositorio público.

PORT=3000

# Clave secreta usada para firmar los tokens de sesión (JWT).
# Cambia este valor por una cadena larga y aleatoria en producción.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-real-y-larga

# Cuánto dura la sesión antes de que el usuario deba volver a iniciar sesión.
JWT_EXPIRES_IN=8h

# Ruta del archivo de base de datos SQLite (se crea automáticamente).
DB_PATH=./data/hostal.db

# Orígenes permitidos para CORS (los dos frontales: panel + sitio público).
# Separados por coma. En el deploy de producción pon las URLs reales.
# En desarrollo local no hace falta tocarlo: el default cubre localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
